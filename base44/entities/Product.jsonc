{
  "name": "Product",
  "type": "object",
  "properties": {
    "seller_id": {
      "type": "string",
      "description": "User ID of the seller"
    },
    "seller_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "quantity": {
      "type": "integer",
      "default": 0
    },
    "species": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "image_url": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "enum": [
        "kg",
        "unit",
        "dozen"
      ],
      "default": "kg"
    }
  },
  "required": [
    "name",
    "price",
    "seller_id"
  ]
}